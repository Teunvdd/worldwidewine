# Kopieer dit bestand naar .env voor lokaal gebruik (npm run dev).
# Op Vercel zet je dezelfde waarden bij Settings → Environment Variables.

# Supabase → Project Settings → Data API (URL) en API Keys (secret key)
SUPABASE_URL=https://jouw-project.supabase.co
# De geheime sleutel (sb_secret_… of de oude service_role-sleutel). Nooit delen of in de browser gebruiken!
SUPABASE_SERVICE_ROLE_KEY=

# Wachtwoord voor de admin-omgeving en kassa
ADMIN_PASSWORD=

# Het adres van de site (voor terugkeer na online betalen), bijv. https://www.worldwidewine.nl
SITE_URL=

# Optioneel: Mollie voor online betalen (test_… of live_…)
MOLLIE_API_KEY=

# Optioneel: e-mails via Resend (melding naar de winkel + bevestiging naar de klant)
RESEND_API_KEY=
MAIL_FROM=worldwidewine.nl <bestellingen@worldwidewine.nl>
SHOP_EMAIL=info@worldwidewine.nl
