# Kopieer dit bestand naar .env voor lokaal gebruik (npm run dev).
# Op Netlify zet je dezelfde waarden bij Site configuration → Environment variables.

# Supabase → Project Settings → API (of Data API)
SUPABASE_URL=https://jouw-project.supabase.co
# De geheime sleutel (sb_secret_… of de oude service_role-sleutel). Nooit delen of in de browser gebruiken!
SUPABASE_SERVICE_ROLE_KEY=

# Wachtwoord voor de admin-omgeving en kassa
ADMIN_PASSWORD=

# Optioneel: Mollie voor online betalen (test_… of live_…)
MOLLIE_API_KEY=
